  "cards": [
    {
      "dot": "cyan",
      "title": "Invariants that keep it honest",
      "items": [
        "One AsyncStream, one drain task: audio reaches the engine in capture order",
        "runGeneration is the cancellation token; every async tail re-checks it",
        "Watchdog on .finishing (30 to 180 s) abandons a hung model with a visible reason",
        "A second press during .finishing is ignored, so nothing pastes twice"
      ]
    },
    {
      "dot": "amber",
      "title": "Off the main path",
      "items": [
        "MediaPauser pauses playback while listening, via perl loading MediaHost.dylib",
        "Settings are read per utterance: a picker change applies on the next hold",
        "Nothing is injected while SigmaFlow itself is the front app (test mode)",
        "Sub-300 ms tap is discarded; a double tap latches hands-free recording"
      ]
    },
    {
      "dot": "violet",
      "title": "Beyond dictation",
      "items": [
        "Option+1…5 rewrite the selection in a saved style (⌘C, rewrite, ⌘V)",
        "Meetings record to AAC and are diarized and transcribed afterwards",
        "SigmaFlowMCP lets Claude Desktop answer questions from runs.jsonl"
      ]
    }
  ]
