    },
    {
      "id": "esc-listening",
      "from": "listening",
      "to": "abandoned",
      "label": "Esc · tap < 300 ms",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 30
    },
    {
      "id": "watchdog",
      "from": "finishing",
      "to": "abandoned",
      "label": "Esc · watchdog",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "recover",
      "from": "abandoned",
      "to": "idle",
      "label": "after 3–4 s",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "bottom"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Main path",
      "items": [
        "Hold = push-to-talk; release ends the utterance",
        "Finishing drains the audio stream, then transcribes, cleans, corrects, expands and injects",
        "A second key press during Finishing is ignored, so nothing pastes twice"
      ]
    },
    {
      "dot": "amber",
      "title": "Hands-free",
      "items": [
        "A sub-300 ms tap is discarded and arms a 350 ms double-tap window",
        "The second tap sets isLatched and starts recording; no key needs holding",
        "Latched is a flag on Listening, not a state: the next tap or any ordinary key ends it like a release"
      ]
    },
    {
      "dot": "rose",
      "title": "Abandon",
      "items": [
        "Esc abandons anything active; the keystroke is swallowed",
        "Watchdog: 30–180 s scaled to speech length, then a visible reason",
        "runGeneration invalidates every async tail of the abandoned run"
      ]
    }
  ]
}
