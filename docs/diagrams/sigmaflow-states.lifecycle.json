          "typed"
        ],
        "note": "The ordinary push-to-talk round trip, from key down to text in the focused app."
      },
      {
        "id": "latch",
        "label": "Hands-free latch",
        "focus": [
          "idle",
          "listening",
          "finishing"
        ],
        "note": "A double tap in Idle sets a latch flag: Listening continues with no key held until the next tap or any ordinary key."
      },
      {
        "id": "abandon",
        "label": "Ways out",
        "focus": [
          "listening",
          "finishing",
          "abandoned",
          "idle"
        ],
        "note": "Esc, a sub-300 ms tap, the watchdog, or an error throw the recording away. Nothing is typed."
      }
    ]
  },
